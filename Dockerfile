# Railway builds this image (railway.json: builder DOCKERFILE) instead of Railpack, whose build driver download failed on Railway's side
# (November 2026). Same steps as Railpack ran: npm ci (postinstall runs prisma generate), next build, next start; the migrations run before each
# deploy (railway.json preDeployCommand: npm run db:deploy). No secrets are baked in: the app reads its variables at runtime.
FROM node:24-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# dependencies (dev ones too: the build needs them, and the pre-deploy step runs the prisma CLI)
FROM base AS deps
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# the Prisma client (src/generated, not in git): generated by npm ci's postinstall in the deps stage
COPY --from=deps /app/src/generated ./src/generated
RUN npm run build

FROM base AS run
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "start"]
