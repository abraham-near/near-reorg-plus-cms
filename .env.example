# CMS (src/cms). Copy to .env (gitignored) and fill in. Never commit real values.

# Postgres. Local: `docker compose up -d`
DATABASE_URL=postgresql://cms:cms@localhost:5433/near_cms_dev
# 32+ random characters: `openssl rand -base64 48`. Signs grants and IP hashes.
AUTH_SECRET=
# Absolute origin used in emails and shown to Claude. Required in production.
CMS_ORIGIN=http://localhost:3000
# Comma-separated exact email domains allowed to hold a CMS account.
CMS_ALLOWED_EMAIL_DOMAINS=near.org,near.foundation,nearfoundation.com,nearsp.com
# Personal API tokens for the Claude MCP server (Settings › Claude).
CMS_API_TOKENS_ENABLED=true

# Claude connector (Claude Desktop, Cowork, claude.ai): the remote MCP endpoint <CMS_ORIGIN>/api/mcp
# and its OAuth sign-in. Off unless true. CMS_ORIGIN must be the exact public https address.
CMS_MCP_ENABLED=false
# Hosts allowed to serve OAuth client metadata documents (CIMD). Default: claude.ai,claude.com
# CMS_OAUTH_CLIENT_HOSTS=claude.ai,claude.com
# Dynamic client registration, for MCP Inspector and clients without CIMD. Keep off in production.
# CMS_OAUTH_DCR_ENABLED=false

# Google Doc import. The service account people share Docs with (as Viewer): its JSON key, base64-encoded
# (`base64 -w0 key.json`). Needs the Google Drive API enabled in its project. Without it, only Docs set to
# "Anyone with the link" can be imported.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Set to false to accept only Docs shared with the service account (no "Anyone with the link").
# CMS_GOOGLE_PUBLIC_EXPORT=true
# Optional: only import Docs owned by these email domains.
# CMS_GOOGLE_OWNER_DOMAINS=near.org

# Optional: Resend, for invitations, password resets and security alerts.
# Without it emails are only logged; create accounts with `npm run cms:create-user`.
RESEND_API_KEY=
CMS_EMAIL_FROM="NEAR CMS <cms@example.org>"

# Optional: S3-compatible bucket for media. Without it, development stores uploads in public/cms.
BUCKET=
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# BUCKET_FORCE_PATH_STYLE=true

# Tests that need Postgres run only when this points at a throwaway database
# (its name must contain "migrate" and "test").
# TEST_DATABASE_URL=postgresql://cms:cms@localhost:5433/near_cms_migrate_test
